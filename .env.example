SECRET_KEY=replace-with-a-long-random-value
FLASK_DEBUG=1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEOAPIFY_API_KEY=
# Local development prints reset links in the Flask terminal. Set to 0 when SMTP is configured.
PASSWORD_RESET_DEV_MODE=1
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
# Port 587: TLS=1 / SSL=0. Port 465: TLS=0 / SSL=1. Do not enable both.
MAIL_USE_TLS=1
MAIL_USE_SSL=0
CONTACT_EMAIL=
# Public HTTPS base URL, e.g. https://tabidea.example.com (local development may leave blank).
PUBLIC_BASE_URL=
